color-link default "white"
color-link comment "green"
color-link identifier "cyan"
color-link constant "cyan"
color-link constant.string "yellow"
color-link constant.string.char "yellow"
color-link constant.number "cyan"
color-link constant.bool "cyan"
color-link symbol "cyan"
color-link type "yellow"
color-link statement "blue,bold"
color-link special "yellow"
color-link preproc "cyan"
color-link underlined "green,underline"
color-link error "red,bold"
color-link todo "yellow,bold"

color-link statusline "black"
color-link tabbar "black"
color-link indent-char "black"
color-link line-number "black"
color-link current-line-number "white"
color-link gutter-error "red"
color-link gutter-warning "yellow"
color-link cursor-line "black"
color-link color-column "black"
color-link diff-added "green"
color-link diff-modified "yellow"
color-link diff-deleted "red"
color-link match-brace "cyan,bold"
